{
  "name": "open-spotify",
  "version": "0.6.0",
  "private": true,
  "description": "A themeable, open-source desktop client for Spotify.",
  "license": "MIT",
  "author": "Armintas",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:renderer": "vite dev",
    "dev:electron": "install-electron && electron-vite dev",
    "build": "vite build && electron-vite build",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:dir": "pnpm build && electron-builder --config electron-builder.yml --dir",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "icons": "node scripts/generate-app-icons.ts"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@effect/platform-node": "4.1.5",
    "@effect/sql-sqlite-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-virtual": "3.14.26",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.70.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "productName": "Open Spotify"
}
